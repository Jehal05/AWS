# Local mode (default): no AWS account needed.
RENEWFLOW_MODE=local
RENEWFLOW_MODEL=mock
RENEWFLOW_CHANNELS=whatsapp,email
RENEWFLOW_DB=renewflow.db
RENEWFLOW_BASE_URL=http://localhost:8000

# AWS mode. Credentials come from the normal AWS chain (instance role, profile or env vars).
# RENEWFLOW_MODE=aws
# RENEWFLOW_MODEL=bedrock
# AWS_REGION=us-east-1
# RENEWFLOW_BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# RENEWFLOW_SES_FROM=renewals@your-verified-domain.com
# RENEWFLOW_SES_CONFIG_SET=renewflow
# RENEWFLOW_WA_PHONE_ID=phone-number-id-...        # from End User Messaging Social
# RENEWFLOW_WA_TEMPLATE=renewal_intro               # approved template for the opening message
# RENEWFLOW_LOCAL_CHANNELS=whatsapp                 # keep a channel simulated until it is live
# RENEWFLOW_WEBHOOK_TOKEN=                          # openssl rand -hex 24
# RENEWFLOW_SNS_TOPIC_ARNS=arn:aws:sns:us-east-1:123456789012:renewflow-events
# RENEWFLOW_ADMIN_TOKEN=                            # enables reset/simulation in AWS mode
# RENEWFLOW_SNS_VERIFY=1                            # set 0 only in tests
