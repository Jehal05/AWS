# RenewFlow configuration. Copy to .env and adjust.

# local = in-process channel simulators; aws = real AWS Communication Developer Services
RENEWFLOW_MODE=local

# mock = deterministic offline model; bedrock = Amazon Bedrock (added in the AWS step)
RENEWFLOW_MODEL=mock

# Channels the agent may use. The AWS Free plan supports WhatsApp (EUM Social) and SES;
# SMS (EUM SMS) needs the Paid plan.
RENEWFLOW_CHANNELS=whatsapp,email

RENEWFLOW_DB=renewflow.db
RENEWFLOW_BASE_URL=http://localhost:8000
